[sub_resource type="GDScript" id="GDScript_epypp"]
script/source = "extends CharacterBody2D

const SPEED: float = 220.0
const SPRINT_SPEED: float = 350.0
const JUMP_VELOCITY: float = -400.0
#const GRAVITY: float = 980.0

const DOUBLE_TAP_TIME: float = 0.3

var last_right_press: float = -1.0
var is_sprinting: bool = false

func _physics_process(delta: float) -> void:

	# Gravity physics when gravity is acting upon the object it holds it down 
	if not is_on_floor():
		velocity.y += GRAVITY * delta

	# moving left and right by getting the axis of the player
	var direction := Input.get_axis(\"move_left\", \"move_right\")

	# double tapping w for sprinting by using ticking function to boost the movement
	if Input.is_action_just_pressed(\"move_right\"):
		var current_time := Time.get_ticks_msec() / 1000.0

		if current_time - last_right_press <= DOUBLE_TAP_TIME:
			is_sprinting = true

		last_right_press = current_time

	# when the direction of the object changes the sprinting stops for better movement
	if direction <= 0:
		is_sprinting = false

	var current_speed := SPRINT_SPEED if is_sprinting else SPEED

	velocity.x = direction * current_speed

	move_and_slide()
"

